#!/usr/bin/env bash
# Launcher: run the TUI from a checkout, from any working directory.
#
# Running the TypeScript sources needs the Solid JSX transform, which arrives as
# a Bun preload; it is named explicitly because bun reads bunfig.toml from the
# caller's cwd, not from this repo. cwd is deliberately left alone, so the
# "track a repository" prompt still defaults to the directory you started in.
# (The published npm package and the release binaries are pre-built and need
# none of this.)
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec bun --preload "$root/node_modules/@opentui/solid/scripts/preload.js" "$root/src/index.tsx" "$@"

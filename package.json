{
  "name": "lazygortex",
  "version": "0.1.0",
  "description": "A terminal UI for the Gortex code-graph daemon, in the spirit of lazygit and lazydocker",
  "keywords": [
    "gortex",
    "tui",
    "terminal",
    "code-graph",
    "lazygit",
    "lazydocker",
    "opentui",
    "cli"
  ],
  "license": "MIT",
  "author": "myndbash",
  "homepage": "https://github.com/myndbash/lazygortex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myndbash/lazygortex.git"
  },
  "bugs": {
    "url": "https://github.com/myndbash/lazygortex/issues"
  },
  "type": "module",
  "bin": {
    "lazygortex": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun --preload @opentui/solid/preload src/index.tsx",
    "dev": "bun --watch --preload @opentui/solid/preload src/index.tsx",
    "build": "bun run scripts/build.ts",
    "build:bundle": "bun run scripts/build.ts --bundle",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{src,test,scripts}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.{ts,tsx}\"",
    "check": "bun run typecheck && bun run format:check && bun test",
    "prepublishOnly": "bun run check && bun run build:bundle"
  },
  "devDependencies": {
    "@opentui/solid": "^0.5.3",
    "@types/bun": "1.3.4",
    "prettier": "3.9.6",
    "solid-js": "1.9.12"
  },
  "dependencies": {
    "@opentui/core": "^0.5.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
